package components

import (
	"fmt"
	"strings"
	"time"

	"github.com/templui/templui/components/table"

	"github.com/rodhor/DiagnosticToolset/internal/domain"
)

templ Results(items []domain.CheckResult) {
	<div class="results-scroll">
		if len(items) == 0 {
			<div class="empty-state"><strong>Waiting for observations</strong><span>The first results appear as checks complete.</span></div>
		} else {
			@table.Table(table.Props{Class: "results-table check-results-table"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Status 
						}
						@table.Head() {
							Check 
						}
						@table.Head() {
							Target 
						}
						@table.Head() {
							Expected 
						}
						@table.Head() {
							Latency 
						}
						@table.Head() {
							Result detail 
						}
						@table.Head() {
							Time 
						}
					}
				}
				@table.Body() {
					for _, r := range items {
						@table.Row() {
							@table.Cell() {
								<span class={ statusClass(r.Status) }>{ strings.ToUpper(string(r.Status)) }</span>
							}
							@table.Cell() {
								<strong>{ r.CheckName }</strong><small class="cell-sub">{ string(r.Category) }</small>
							}
							@table.Cell() {
								<span class="data-value">{ r.Target }</span>
							}
							@table.Cell() {
								{ expectedText(r.Expected) }
							}
							@table.Cell() {
								<span class="data-value">{ formatLatency(r.Latency) }</span>
							}
							@table.Cell() {
								<span class="detail-cell" title={ resultDetail(r) }>{ resultDetail(r) }</span>
							}
							@table.Cell() {
								<time>{ r.Timestamp.Format("15:04:05") }</time>
							}
						}
					}
				}
			}
		}
	</div>
}

func expectedText(expected string) string {
	if expected == "" || expected == "SUCCESS" {
		return "Success"
	}
	return expected
}

func statusClass(status domain.ResultStatus) string {
	switch status {
	case domain.Pass:
		return "status-chip status-pass"
	case domain.Warn:
		return "status-chip status-warn"
	case domain.Fail:
		return "status-chip status-fail"
	default:
		return "status-chip status-unknown"
	}
}

func resultDetail(r domain.CheckResult) string {
	if r.Err != "" {
		return r.Err
	}
	for _, metric := range r.Metrics {
		if metric.Primary && metric.Label != "Latency" && metric.Display != "" {
			return metric.Label + ": " + metric.Display
		}
	}
	if r.Reason != "" {
		return strings.ReplaceAll(r.Reason, "_", " ")
	}
	return "—"
}

func formatLatency(d time.Duration) string {
	if d == 0 {
		return "—"
	}
	return fmt.Sprintf("%v", d.Round(time.Microsecond))
}
