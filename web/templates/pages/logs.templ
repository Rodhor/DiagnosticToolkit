package pages

import (
	"fmt"

	"github.com/rodhor/DiagnosticToolset/web/templates/components"
	"github.com/rodhor/DiagnosticToolset/web/templates/layouts"
)

templ Logs(runID int) {
	@layouts.AppShell("Logs", "logs", logsContent(runID))
}

templ logsContent(runID int) {
	<div class="page-heading page-heading-row">
		<div><h1>Run logs</h1><p>Observations in execution order, including expected outcomes and measured latency.</p></div>
		if runID > 0 {
			<span class="run-reference">Run { fmt.Sprintf("%d", runID) }</span>
		}
	</div>
	<section class="section-block">
		<div class="section-heading"><div><h2>Check observations</h2><p>Live results refresh automatically while monitoring is active.</p></div></div>
		@components.ResultsPoller(logsResultsURL(runID))
	</section>
}

func logsResultsURL(runID int) string {
	if runID > 0 {
		return fmt.Sprintf("/partials/results?run=%d", runID)
	}
	return "/partials/results"
}
