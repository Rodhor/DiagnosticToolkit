package pages

import (
	"fmt"
	"net/netip"
	"strings"
	"time"

	"github.com/templui/templui/components/button"

	"github.com/rodhor/DiagnosticToolset/internal/platform"
	"github.com/rodhor/DiagnosticToolset/internal/web/server"
	"github.com/rodhor/DiagnosticToolset/web/templates/components"
	"github.com/rodhor/DiagnosticToolset/web/templates/layouts"
)

templ Dashboard(running bool, runs []*server.Run, snapshot platform.Snapshot, snapshotErr string) {
	@layouts.AppShell("Overview", "overview", dashboardContent(running, runs, snapshot, snapshotErr))
}

templ dashboardContent(running bool, runs []*server.Run, snapshot platform.Snapshot, snapshotErr string) {
	<div class="page-heading page-heading-row">
		<div>
			<h1>Network overview</h1>
			<p>Run connectivity checks and inspect the network behind the result.</p>
		</div>
		<div class="run-controls">
			@components.Status(running)
			if running {
				@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeButton, Attributes: templ.Attributes{"hx-post": "/actions/stop"}}) {
					Stop monitoring 
				}
			} else {
				@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"hx-post": "/actions/start", "hx-target": "#status", "hx-swap": "outerHTML", "hx-on::after-request": "if(event.detail.successful) window.location.reload()"}}) {
					Start monitoring 
				}
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"hx-post": "/actions/run-once", "hx-target": "#once-result", "hx-swap": "innerHTML", "hx-on::after-request": "if(event.detail.successful) document.getElementById('once-result').classList.add('is-visible')"}}) {
				Run once 
			}
		</div>
	</div>
	<div id="once-result" class="run-once-result" aria-live="polite"></div>
	<section class="section-block topology-section" aria-labelledby="overview-path-title">
		<div class="section-heading"><div><h2 id="overview-path-title">Default network path</h2><p>Discovered host-to-gateway relationship; not geographic scale.</p></div><a class="text-link" href="/environment">Environment details</a></div>
		if snapshotErr != "" {
			<div class="notice notice-error" role="status">Network environment could not be discovered: { snapshotErr }</div>
		} else {
			@components.NetworkPath(snapshot)
			<div class="resolver-strip"><span>System resolvers</span>{ resolverSummary(snapshot.Resolvers) }</div>
		}
	</section>
	if running {
		<section class="section-block" aria-labelledby="live-results-title">
			<div class="section-heading">
				<div><h2 id="live-results-title">Current run</h2><p>New observations appear as checks complete.</p></div>
				<span class="live-label"><i></i>Live</span>
			</div>
			@components.ResultsPoller("/partials/results")
		</section>
	} else {
		<section class="idle-panel" aria-labelledby="ready-title">
			<div class="idle-copy"><span class="section-label">READY WHEN YOU ARE</span><h2 id="ready-title">Monitoring is idle</h2><p>Start monitoring for recurring results, or run a one-time snapshot.</p></div>
			<div class="idle-facts"><span>TCP</span><span>DNS</span><span>Ping</span></div>
		</section>
		<section class="section-block" id="history" aria-labelledby="history-title">
			<div class="section-heading">
				<div><h2 id="history-title">Previous runs</h2><p>Open a run to inspect its observations or summary.</p></div>
				<a class="text-link" href="/history">View history</a>
			</div>
			if len(runs) == 0 {
				<div class="empty-state"><strong>No runs yet</strong><span>Your completed monitoring and one-time runs will appear here.</span></div>
			} else {
				<div class="run-list">
					for _, run := range runs {
						<div class="run-row">
							<div class="run-id"><span>Run { fmt.Sprintf("%d", run.ID) }</span><small>{ run.Mode }</small></div>
							<div class="run-time"><span>{ run.Started.Format("Jan 02, 2006 · 15:04:05") }</span><small>{ runDuration(run) }</small></div>
							<div class="run-count"><span>{ fmt.Sprintf("%d", runObs(run)) }</span><small>observations</small></div>
							<div class="run-actions"><a href={ templ.SafeURL(fmt.Sprintf("/logs?run=%d", run.ID)) }>Logs</a><a href={ templ.SafeURL(fmt.Sprintf("/summary?run=%d", run.ID)) }>Summary</a></div>
						</div>
					}
				</div>
			}
		</section>
	}
}

func runObs(r *server.Run) int {
	if r == nil || r.Buffer == nil {
		return 0
	}
	return len(r.Buffer.All())
}

func runDuration(r *server.Run) string {
	if r == nil || r.Started.IsZero() {
		return ""
	}
	ended := r.Ended
	if ended.IsZero() {
		ended = time.Now()
	}
	return ended.Sub(r.Started).Round(time.Second).String()
}

func resolverSummary(addrs []netip.Addr) string {
	values := make([]string, 0, len(addrs))
	for _, addr := range addrs {
		if addr.IsValid() {
			values = append(values, addr.String())
		}
	}
	if len(values) == 0 {
		return "Not discovered"
	}
	return strings.Join(values, " · ")
}
