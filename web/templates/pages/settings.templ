package pages

import (
	"fmt"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/tagsinput"

	"github.com/rodhor/DiagnosticToolset/internal/app"
)

templ Settings(v app.SettingsView, saved bool) {
	<!DOCTYPE html>
	<html class="dark">
	<head>
		<link rel="stylesheet" href="/assets/css/output.css">
		@tagsinput.Script()
		<title>Settings</title>
	</head>
	<body class="p-6 space-y-4 max-w-5xl mx-auto">
		@card.Card() {
			@card.Header() {
				@card.Title() { Settings }
				@card.Description() { Edit netcheck configuration }
			}
			@card.Content() {
				if saved {
					<p class="text-green-500 mb-3">Saved and reloaded.</p>
				}
				<form method="post" action="/actions/save-config" class="space-y-6">
					<!-- General: 2 rows x 3 cols -->
					<section class="space-y-2">
						<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">General</h3>
						<div class="grid grid-cols-3 gap-1">
							<div>
								@label.Label() { Timeout }
								@input.Input(input.Props{Name: "timeout", Value: v.Timeout, Placeholder: "3s", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Concurrency }
								@input.Input(input.Props{Name: "concurrency", Value: fmtInt(v.Concurrency), Placeholder: "4", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Default interval }
								@input.Input(input.Props{Name: "interval", Value: v.Interval, Placeholder: "30s", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Threshold TCP }
								@input.Input(input.Props{Name: "threshold_tcp", Value: v.ThresholdTCP, Placeholder: "300ms", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Threshold DNS }
								@input.Input(input.Props{Name: "threshold_dns", Value: v.ThresholdDNS, Placeholder: "200ms", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Threshold Ping }
								@input.Input(input.Props{Name: "threshold_ping", Value: v.ThresholdPing, Placeholder: "150ms", Class: "h-7 text-xs"})
							</div>
						</div>
					</section>

					<!-- Targets: tcp + ping side by side -->
					<section class="space-y-3">
						<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">Targets</h3>
						<div class="grid grid-cols-2 gap-3">
							<div>
								@label.Label() { TCP targets }
								@tagsinput.TagsInput(tagsinput.Props{Name: "tcp_targets", Value: v.TCPTargets, Placeholder: "1.1.1.1:53"})
							</div>
							<div>
								@label.Label() { Ping targets }
								@tagsinput.TagsInput(tagsinput.Props{Name: "ping_targets", Value: v.PingTargets, Placeholder: "1.1.1.1"})
							</div>
						</div>
						<div>
							@label.Label() { DNS resolvers (name=address) }
							@tagsinput.TagsInput(tagsinput.Props{Name: "resolvers", Value: v.Resolvers, Placeholder: "Cloudflare=1.1.1.1"})
						</div>
					</section>

					<!-- DNS queries -->
					<section class="space-y-3">
						<div class="flex items-center justify-between">
							<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">DNS queries</h3>
							<button type="button" onclick="addQueryRow()" class="text-sm text-primary hover:underline">+ Add</button>
						</div>
						<div class="rounded-md border overflow-hidden">
							<table class="w-full text-sm">
								<thead class="bg-muted/50">
									<tr>
										<th class="text-left px-3 py-2 font-medium">Domain</th>
										<th class="text-left px-3 py-2 font-medium">Expected IPs (optional)</th>
										<th class="text-left px-3 py-2 font-medium w-32">Expected outcome</th>
										<th class="w-10"></th>
									</tr>
								</thead>
								<tbody id="q-rows">
									for i := 0; i < qRowCount(v.Queries); i++ {
										<tr class="border-t border-border" data-idx={ fmt.Sprintf("%d", i) }>
											<td class="px-2 py-1">
												<input name={ fmt.Sprintf("q_name_%d", i) } value={ qName(v.Queries, i) } placeholder="google.com" class="w-full bg-transparent outline-none" />
											</td>
											<td class="px-2 py-1">
												<input name={ fmt.Sprintf("q_expected_%d", i) } value={ qExpected(v.Queries, i) } placeholder="" class="w-full bg-transparent outline-none" />
											</td>
											<td class="px-2 py-1">
												<select name={ fmt.Sprintf("q_expect_%d", i) } class="w-full bg-transparent outline-none">
													<option value="" selected?={ qExpect(v.Queries, i) == "" }>SUCCESS</option>
													<option value="NXDOMAIN" selected?={ qExpect(v.Queries, i) == "NXDOMAIN" }>NXDOMAIN</option>
												</select>
											</td>
											<td class="px-2 py-1 text-center">
												<button type="button" onclick="removeQueryRow(this)" class="text-muted-foreground hover:text-destructive">&times;</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
							<p class="text-xs text-muted-foreground px-2 py-1">Leave Expected IPs empty for NXDOMAIN checks.</p>
						</div>
						<template id="q-row-tpl">
							<tr class="border-t border-border" data-idx="__IDX__">
								<td class="px-2 py-1"><input name="q_name___IDX__" placeholder="google.com" class="w-full bg-transparent outline-none" /></td>
								<td class="px-2 py-1"><input name="q_expected___IDX__" placeholder="" class="w-full bg-transparent outline-none" /></td>
								<td class="px-2 py-1">
									<select name="q_expect___IDX__" class="w-full bg-transparent outline-none">
										<option value="" selected>SUCCESS</option>
										<option value="NXDOMAIN">NXDOMAIN</option>
									</select>
								</td>
								<td class="px-2 py-1 text-center">
									<button type="button" onclick="removeQueryRow(this)" class="text-muted-foreground hover:text-destructive">&times;</button>
								</td>
							</tr>
						</template>
						<script>
							let qIdx = 0;
							(function(){ qIdx = document.querySelectorAll('#q-rows tr').length; })();
							function addQueryRow() {
								const tpl = document.getElementById('q-row-tpl').innerHTML;
								const html = tpl.replace(/__IDX__/g, qIdx++);
								const tbody = document.getElementById('q-rows');
								const tmp = document.createElement('tbody');
								tmp.innerHTML = html;
								tbody.appendChild(tmp.firstElementChild);
							}
							function removeQueryRow(btn) {
								btn.closest('tr').remove();
							}
						</script>
					</section>

					<!-- Ping + Output files combined, 4 columns -->
					<section class="space-y-3">
						<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">Ping &amp; Output</h3>
						<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
							<div>
								@label.Label() { Ping count }
								@input.Input(input.Props{Name: "ping_count", Value: fmtInt(v.PingCount), Placeholder: "10", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Ping interval }
								@input.Input(input.Props{Name: "ping_interval", Value: v.PingInterval, Placeholder: "200ms", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Ping timeout }
								@input.Input(input.Props{Name: "ping_timeout", Value: v.PingTimeout, Placeholder: "5s", Class: "h-7 text-xs"})
							</div>

							<div>
								@label.Label() { Warn loss % }
								@input.Input(input.Props{Name: "ping_warn_loss", Value: fmtFloat(v.PingWarnLoss), Placeholder: "1", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Fail loss % }
								@input.Input(input.Props{Name: "ping_fail_loss", Value: fmtFloat(v.PingFailLoss), Placeholder: "50", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Results file }
								@input.Input(input.Props{Name: "output_results", Value: v.OutputResults, Placeholder: "results.json", Class: "h-7 text-xs"})
							</div>
							<div>
								@label.Label() { Summary file }
								@input.Input(input.Props{Name: "output_summary", Value: v.OutputSummary, Placeholder: "summary.json", Class: "h-7 text-xs"})
							</div>
						</div>
					</section>

					<div class="mt-4">
						@button.Button(button.Props{Type: button.TypeSubmit}) { Save &amp; reload }
					</div>
				</form>
			}
		}
		<div class="flex gap-4">
			<a href="/" class="underline">Back to dashboard</a>
		</div>
	</body>
	</html>
}
