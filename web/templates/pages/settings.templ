package pages

import (
	"fmt"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/tagsinput"

	"github.com/rodhor/DiagnosticToolset/internal/app"
	"github.com/rodhor/DiagnosticToolset/web/templates/layouts"
)

templ Settings(v app.SettingsView, saved bool, loadError, saveError string) {
	@layouts.AppShell("Settings", "settings", settingsContent(v, saved, loadError, saveError))
}

templ settingsContent(v app.SettingsView, saved bool, loadError, saveError string) {
	<div class="page-heading"><h1>Settings</h1><p>Adjust what the diagnostic runner checks and how it reports results.</p></div>
	if saved {
		<div class="notice notice-success" role="status"><strong>Configuration saved.</strong> The next run uses these settings; an active run continues with its original configuration.</div>
	}
	if loadError != "" {
		<div class="notice notice-error" role="alert"><strong>Configuration could not be loaded.</strong> { loadError } The values below are defaults; saving will replace the invalid file.</div>
	}
	if saveError != "" {
		<div class="notice notice-error" role="alert"><strong>Settings were not saved.</strong> { saveError }</div>
	}
	<form method="post" action="/actions/save-config" class="settings-form">
		<section class="section-block settings-section" aria-labelledby="general-title">
			<div class="section-heading"><div><h2 id="general-title">General and thresholds</h2><p>Timing values use Go duration syntax, for example 300ms or 3s.</p></div></div>
			<div class="settings-grid settings-grid-3">
				<div class="field"><label for="timeout">Check timeout</label>@input.Input(input.Props{ID: "timeout", Name: "timeout", Value: v.Timeout, Placeholder: "3s"})<small>Maximum wait for TCP and DNS checks.</small></div>
				<div class="field"><label for="concurrency">Concurrency</label>@input.Input(input.Props{ID: "concurrency", Name: "concurrency", Value: v.Concurrency, Placeholder: "4"})<small>Checks allowed to run in parallel.</small></div>
				<div class="field"><label for="interval">Default interval</label>@input.Input(input.Props{ID: "interval", Name: "interval", Value: v.Interval, Placeholder: "30s"})<small>Used when a check has no specific schedule.</small></div>
				<div class="field"><label for="threshold_tcp">TCP warning threshold</label>@input.Input(input.Props{ID: "threshold_tcp", Name: "threshold_tcp", Value: v.ThresholdTCP, Placeholder: "300ms"})</div>
				<div class="field"><label for="threshold_dns">DNS warning threshold</label>@input.Input(input.Props{ID: "threshold_dns", Name: "threshold_dns", Value: v.ThresholdDNS, Placeholder: "200ms"})</div>
				<div class="field"><label for="threshold_ping">Ping warning threshold</label>@input.Input(input.Props{ID: "threshold_ping", Name: "threshold_ping", Value: v.ThresholdPing, Placeholder: "150ms"})</div>
			</div>
		</section>
		<section class="section-block settings-section" aria-labelledby="targets-title">
			<div class="section-heading"><div><h2 id="targets-title">Targets and resolvers</h2><p>Type a value and press Enter to add another target.</p></div></div>
			<div class="settings-grid settings-grid-2">
				<div class="field"><label for="tcp-targets">TCP targets</label>@tagsinput.TagsInput(tagsinput.Props{ID: "tcp-targets", Name: "tcp_targets", Value: v.TCPTargets, Placeholder: "1.1.1.1:53"})<small>Hostnames may include a port, such as example.com:443.</small></div>
				<div class="field"><label for="ping-targets">Ping targets</label>@tagsinput.TagsInput(tagsinput.Props{ID: "ping-targets", Name: "ping_targets", Value: v.PingTargets, Placeholder: "1.1.1.1"})<small>IP addresses to check with ICMP.</small></div>
			</div>
			<div class="field resolver-field"><label for="resolvers">DNS resolvers</label>@tagsinput.TagsInput(tagsinput.Props{ID: "resolvers", Name: "resolvers", Value: v.Resolvers, Placeholder: "Cloudflare=1.1.1.1"})<small>Use name=address. Leave the address empty for the system resolver, e.g. System.</small></div>
		</section>
		<section class="section-block settings-section" aria-labelledby="queries-title">
			<div class="section-heading"><div><h2 id="queries-title">DNS queries</h2><p>Expected outcome describes what a correct answer looks like for each domain.</p></div><button type="button" class="text-button" onclick="addQueryRow()">Add query</button></div>
			<div class="table-scroll query-table-scroll">
				<table class="data-table query-table">
					<thead><tr><th>Domain</th><th>Expected IP addresses</th><th>Expected outcome</th><th><span class="sr-only">Remove</span></th></tr></thead>
					<tbody id="q-rows">
						for i := 0; i < qRowCount(v.Queries); i++ {
							<tr>
								<td><input aria-label="Domain" name={ fmt.Sprintf("q_name_%d", i) } value={ qName(v.Queries, i) } placeholder="google.com"/></td>
								<td><input aria-label="Expected IP addresses, comma-separated" name={ fmt.Sprintf("q_expected_%d", i) } value={ qExpected(v.Queries, i) } placeholder="Optional; comma-separated" disabled?={ qExpect(v.Queries, i) == "NXDOMAIN" }/></td>
								<td><select aria-label="Expected DNS outcome" name={ fmt.Sprintf("q_expect_%d", i) } onchange="toggleExpected(this)"><option value="" selected?={ qExpect(v.Queries, i) == "" }>Successful lookup</option><option value="NXDOMAIN" selected?={ qExpect(v.Queries, i) == "NXDOMAIN" }>NXDOMAIN</option></select></td>
								<td><button type="button" class="remove-row" aria-label="Remove DNS query" onclick="removeQueryRow(this)">Remove</button></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="field-help">Expected IPs are optional for successful lookups and are disabled for NXDOMAIN checks.</p>
			<template id="q-row-tpl">
				<tr>
					<td><input aria-label="Domain" name="q_name___IDX__" placeholder="google.com"/></td>
					<td><input aria-label="Expected IP addresses, comma-separated" name="q_expected___IDX__" placeholder="Optional; comma-separated"/></td>
					<td><select aria-label="Expected DNS outcome" name="q_expect___IDX__" onchange="toggleExpected(this)"><option value="" selected>Successful lookup</option><option value="NXDOMAIN">NXDOMAIN</option></select></td>
					<td><button type="button" class="remove-row" aria-label="Remove DNS query" onclick="removeQueryRow(this)">Remove</button></td>
				</tr>
			</template>
			<script>
				let qIdx = 0;
				(function(){ qIdx = document.querySelectorAll('#q-rows tr').length; })();
				function addQueryRow() {
					const html = document.getElementById('q-row-tpl').innerHTML.replace(/__IDX__/g, qIdx++);
					const staging = document.createElement('tbody');
					staging.innerHTML = html;
					document.getElementById('q-rows').appendChild(staging.firstElementChild);
				}
				function removeQueryRow(button) { button.closest('tr').remove(); }
				function toggleExpected(select) {
					const field = select.closest('tr').querySelector('input[name^="q_expected_"]');
					field.disabled = select.value === 'NXDOMAIN';
					if (field.disabled) field.value = '';
				}
			</script>
		</section>
		<section class="section-block settings-section" aria-labelledby="ping-title">
			<div class="section-heading"><div><h2 id="ping-title">Ping and output</h2><p>Privileged ping is always enabled for consistent cross-platform behavior.</p></div></div>
			<div class="settings-grid settings-grid-4">
				<div class="field"><label for="ping_count">Ping count</label>@input.Input(input.Props{ID: "ping_count", Name: "ping_count", Value: v.PingCount, Placeholder: "10"})</div>
				<div class="field"><label for="ping_interval">Packet interval</label>@input.Input(input.Props{ID: "ping_interval", Name: "ping_interval", Value: v.PingInterval, Placeholder: "200ms"})</div>
				<div class="field"><label for="ping_timeout">Ping timeout</label>@input.Input(input.Props{ID: "ping_timeout", Name: "ping_timeout", Value: v.PingTimeout, Placeholder: "5s"})</div>
				<div class="field"><label for="ping_warn_loss">Warn packet loss (%)</label>@input.Input(input.Props{ID: "ping_warn_loss", Name: "ping_warn_loss", Value: v.PingWarnLoss, Placeholder: "1"})</div>
				<div class="field"><label for="ping_fail_loss">Fail packet loss (%)</label>@input.Input(input.Props{ID: "ping_fail_loss", Name: "ping_fail_loss", Value: v.PingFailLoss, Placeholder: "50"})</div>
				<div class="field"><label for="output_results">Results file</label>@input.Input(input.Props{ID: "output_results", Name: "output_results", Value: v.OutputResults, Placeholder: "results.jsonl"})</div>
				<div class="field"><label for="output_summary">Summary file</label>@input.Input(input.Props{ID: "output_summary", Name: "output_summary", Value: v.OutputSummary, Placeholder: "summary.json"})</div>
			</div>
		</section>
		<div class="settings-footer">
			<span>Settings are validated before they replace the active configuration.</span>@button.Button(button.Props{Type: button.TypeSubmit}) {
	Save and reload 
}
		</div>
	</form>
}
