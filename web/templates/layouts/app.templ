package layouts

templ AppShell(title, active string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script>
				(function () {
					try {
						const theme = localStorage.getItem("diagnostic-toolkit-theme");
						const dark = theme === "dark" || (!theme);
						if (dark) document.documentElement.classList.add("dark");
					} catch (error) {}
				})();
			</script>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
			<title>{ title } · DiagnosticToolkit</title>
		</head>
		<body class="app-body">
			<div class="app-shell">
				<aside class="sidebar" aria-label="Main navigation">
					<a class="brand" href="/">
						<span class="brand-mark" aria-hidden="true">DT</span>
						<span><strong>DiagnosticToolkit</strong><small>Network diagnostics</small></span>
					</a>
					<nav class="nav-list">
						@navLink("/", "Overview", active == "overview")
						@navLink("/environment", "Environment", active == "environment")
						@navLink("/logs", "Live logs", active == "logs")
						@navLink("/history", "Run history", active == "history")
						@navLink("/settings", "Settings", active == "settings")
					</nav>
					<div class="sidebar-foot">
						<span class="local-indicator"></span>
						<span>Local session</span>
					</div>
				</aside>
				<div class="main-column">
					<header class="topbar">
						<div class="topbar-title">Network diagnostics <span>/</span> { title }</div>
						<div class="theme-toggle-wrap">
							<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" aria-pressed="false">
								<span class="theme-toggle-icon theme-icon-sun" aria-hidden="true">
									<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3"></circle><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M3.1 12.9l1.1-1.1M11.8 4.2l1.1-1.1"></path></svg>
								</span>
								<span class="theme-toggle-icon theme-icon-moon" aria-hidden="true">
									<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z"></path></svg>
								</span>
							</button>
							<span class="topbar-note">Runs on this device</span>
						</div>
					</header>
					<main class="page-content">
						@content
					</main>
				</div>
			</div>
		</body>
	</html>
}

templ navLink(href, label string, active bool) {
	if active {
		<a class="nav-link nav-link-active" href={ templ.SafeURL(href) } aria-current="page"><span>{ label }</span><span class="nav-marker" aria-hidden="true"></span></a>
	} else {
		<a class="nav-link" href={ templ.SafeURL(href) }><span>{ label }</span></a>
	}
}
